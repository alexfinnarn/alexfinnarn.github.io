---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Work - Web Developer & Consultant">
  <main class="work-page">
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <div class="hero-text">
            <h1>Web Developer & Consultant</h1>
            <p class="hero-subtitle">
              I create modern, performant web applications and help businesses build their digital presence.
              Specializing in React, TypeScript, and full-stack development with a focus on user experience.
            </p>
            <a href="#contact" class="cta-button">Available for Consulting</a>
          </div>
          <div class="hero-image">
            <div class="headshot-placeholder">
              <span>Your Photo Here</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Services/Expertise Section -->
    <section class="services surface">
      <div class="container">
        <h2>Services & Expertise</h2>
        <div class="services-grid grid-auto-fit">
          <div class="service-card surface">
            <h3>Frontend Development</h3>
            <p>Modern React applications with TypeScript, responsive design, and optimal performance.</p>
          </div>
          <div class="service-card surface">
            <h3>Full-Stack Solutions</h3>
            <p>End-to-end web applications with robust backends and seamless user experiences.</p>
          </div>
          <div class="service-card surface">
            <h3>Performance Optimization</h3>
            <p>Speed up your existing applications and improve Core Web Vitals for better SEO.</p>
          </div>
          <div class="service-card surface">
            <h3>Technical Consulting</h3>
            <p>Architecture planning, code reviews, and strategic technical guidance for your team.</p>
          </div>
        </div>

        <div class="tech-stack">
          <h3>Technologies I Work With</h3>
          <div class="tech-badges">
            <span class="tech-badge">React</span>
            <span class="tech-badge">TypeScript</span>
            <span class="tech-badge">Astro</span>
            <span class="tech-badge">Three.js</span>
            <span class="tech-badge">Node.js</span>
            <span class="tech-badge">Playwright</span>
            <span class="tech-badge">Git</span>
            <span class="tech-badge">Responsive Design</span>
          </div>
        </div>

        <div class="approach surface">
          <h3>My Approach</h3>
          <p>
            I believe in writing clean, maintainable code that scales with your business. My development
            process emphasizes testing, performance, and user-centered design. I work closely with clients
            to understand their goals and deliver solutions that exceed expectations.
          </p>
        </div>
      </div>
    </section>

    <!-- Featured Projects Portfolio -->
    <section class="portfolio">
      <div class="container">
        <h2>Featured Projects</h2>
        <div class="projects-grid grid-auto-fit">
          <article class="project-card surface">
            <div class="project-image">
              <div class="placeholder-image">Project Screenshot</div>
            </div>
            <div class="project-content flow">
              <h3>E-Commerce Platform</h3>
              <p>
                Built a modern e-commerce solution with React and Node.js, featuring real-time inventory
                management and seamless checkout experience.
              </p>
              <div class="project-tech">
                <span>React</span>
                <span>TypeScript</span>
                <span>Node.js</span>
                <span>PostgreSQL</span>
              </div>
              <div class="project-links">
                <a href="#" class="project-link">Live Site</a>
                <a href="#" class="project-link">GitHub</a>
              </div>
              <p class="project-impact">Results: 40% increase in conversion rate, 60% faster page loads</p>
            </div>
          </article>

          <article class="project-card surface">
            <div class="project-image">
              <div class="placeholder-image">Project Screenshot</div>
            </div>
            <div class="project-content flow">
              <h3>Interactive Data Visualization</h3>
              <p>
                Created an interactive dashboard using Three.js and React to visualize complex datasets
                for a financial services company.
              </p>
              <div class="project-tech">
                <span>React</span>
                <span>Three.js</span>
                <span>D3.js</span>
                <span>WebGL</span>
              </div>
              <div class="project-links">
                <a href="#" class="project-link">Live Demo</a>
                <a href="#" class="project-link">Case Study</a>
              </div>
              <p class="project-impact">Results: 3x improvement in data analysis efficiency</p>
            </div>
          </article>

          <article class="project-card surface">
            <div class="project-image">
              <div class="placeholder-image">Project Screenshot</div>
            </div>
            <div class="project-content flow">
              <h3>Content Management System</h3>
              <p>
                Developed a headless CMS with Astro and custom admin interface, optimized for SEO
                and content creator workflows.
              </p>
              <div class="project-tech">
                <span>Astro</span>
                <span>React</span>
                <span>MDX</span>
                <span>Cloudinary</span>
              </div>
              <div class="project-links">
                <a href="#" class="project-link">Live Site</a>
                <a href="#" class="project-link">Documentation</a>
              </div>
              <p class="project-impact">Results: 90+ Lighthouse score, 50% faster content publishing</p>
            </div>
          </article>

          <article class="project-card surface">
            <div class="project-image">
              <div class="placeholder-image">Project Screenshot</div>
            </div>
            <div class="project-content flow">
              <h3>Real-Time Collaboration Tool</h3>
              <p>
                Built a collaborative workspace application with real-time updates, file sharing,
                and team communication features.
              </p>
              <div class="project-tech">
                <span>React</span>
                <span>WebSockets</span>
                <span>Redis</span>
                <span>AWS</span>
              </div>
              <div class="project-links">
                <a href="#" class="project-link">Beta Access</a>
                <a href="#" class="project-link">Technical Blog</a>
              </div>
              <p class="project-impact">Results: 200+ active users, 99.9% uptime</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Skills & Technologies -->
    <section class="skills surface">
      <div class="container">
        <h2>Skills & Technologies</h2>
        <div class="skills-grid grid-auto-fit">
          <div class="skill-category surface">
            <h3>Frontend</h3>
            <ul role="list">
              <li>React & React Native</li>
              <li>TypeScript & JavaScript (ES6+)</li>
              <li>HTML5 & CSS3/SCSS</li>
              <li>Three.js & WebGL</li>
              <li>Astro & Next.js</li>
              <li>Responsive & Mobile-First Design</li>
            </ul>
          </div>
          <div class="skill-category surface">
            <h3>Backend & Tools</h3>
            <ul role="list">
              <li>Node.js & Express</li>
              <li>RESTful APIs & GraphQL</li>
              <li>PostgreSQL & MongoDB</li>
              <li>Git & GitHub</li>
              <li>Docker & AWS</li>
              <li>Testing (Jest, Playwright)</li>
            </ul>
          </div>
          <div class="skill-category surface">
            <h3>Soft Skills</h3>
            <ul role="list">
              <li>Client Communication</li>
              <li>Project Management</li>
              <li>Technical Leadership</li>
              <li>Problem Solving</li>
              <li>Code Review & Mentoring</li>
              <li>Agile Development</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="testimonials">
      <div class="container">
        <h2>What Clients Say</h2>
        <div class="testimonials-grid grid-auto-fit">
          <blockquote class="testimonial">
            <p>
              Working with [Your Name] was exceptional. They delivered a high-quality solution on time
              and provided excellent technical guidance throughout the project. The performance improvements
              they implemented exceeded our expectations.
            </p>
            <cite>— Sarah Johnson, CTO at TechStart Inc.</cite>
          </blockquote>
          <blockquote class="testimonial">
            <p>
              Their expertise in React and modern web development helped us completely transform our
              user experience. The new platform is faster, more intuitive, and our users love it.
            </p>
            <cite>— Michael Chen, Product Manager at DataFlow</cite>
          </blockquote>
          <blockquote class="testimonial">
            <p>
              Professional, reliable, and incredibly skilled. They took our complex requirements and
              turned them into a beautiful, functional application. Highly recommend for any web
              development project.
            </p>
            <cite>— Emma Rodriguez, Founder at Creative Solutions</cite>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- Availability & Contact -->
    <section class="availability surface" id="contact">
      <div class="container">
        <h2>Let's Work Together</h2>
        <div class="availability-content">
          <div class="availability-info">
            <h3>Current Availability</h3>
            <p class="status">
              <span class="status-indicator available"></span>
              Available for new projects starting February 2025
            </p>

            <h3>Project Types I'm Seeking</h3>
            <ul role="list">
              <li>Web application development (2-6 month projects)</li>
              <li>Performance optimization and technical audits</li>
              <li>Frontend architecture and code reviews</li>
              <li>Ongoing development partnerships</li>
            </ul>

            <h3>Preferred Project Scope</h3>
            <ul role="list">
              <li>Budget range: $5,000 - $50,000+</li>
              <li>Timeline: 1-6 months</li>
              <li>Remote collaboration welcome</li>
              <li>Long-term partnerships preferred</li>
            </ul>
          </div>

          <div class="contact-info">
            <h3>Get In Touch</h3>
            <p>Ready to discuss your project? I typically respond within 24 hours.</p>

            <div class="contact-methods flow">
              <a href="mailto:your.email@example.com" class="contact-method surface">
                <span>📧</span>
                <div>
                  <strong>Email</strong>
                  <span>your.email@example.com</span>
                </div>
              </a>
              <a href="https://linkedin.com/in/yourprofile" class="contact-method surface">
                <span>💼</span>
                <div>
                  <strong>LinkedIn</strong>
                  <span>Connect with me</span>
                </div>
              </a>
              <a href="https://calendly.com/yourname" class="contact-method surface">
                <span>📅</span>
                <div>
                  <strong>Schedule a Call</strong>
                  <span>15-minute consultation</span>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
    .work-page {
        display: flex;
        flex-direction: column;
        gap: var(--size-6);
    }

    /* Hero Section */
    .hero {
        background: linear-gradient(135deg, var(--clr-accent) 0%, var(--purple-6) 100%);
        color: var(--clr-bg-1);
        padding: var(--size-10) var(--size-4);
        border-radius: var(--radius-3);
        margin: var(--size-4);
    }

    .hero-content {
        max-width: var(--size-content-3);
        margin: 0 auto;
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: var(--size-6);
        align-items: center;
    }

    .hero-text {
        text-align: left;
    }

    .hero h1 {
        font-size: var(--font-size-8);
        margin-bottom: var(--size-3);
        font-weight: var(--font-weight-7);
    }

    .hero-subtitle {
        font-size: var(--font-size-4);
        margin-bottom: var(--size-5);
        opacity: 0.9;
        line-height: var(--font-lineheight-3);
        padding: 0;
        max-inline-size: none;
    }

    .hero-image {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .headshot-placeholder {
        width: var(--size-15);
        height: var(--size-15);
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        border: 3px solid rgba(255, 255, 255, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(10px);
        font-size: var(--font-size-2);
        font-weight: var(--font-weight-5);
        text-align: center;
        transition: transform var(--animation-fade-in);
    }

    .headshot-placeholder:hover {
        transform: scale(1.05);
    }

    .cta-button {
        display: inline-block;
        background: var(--clr-bg-1);
        color: var(--clr-accent);
        padding: var(--size-3) var(--size-5);
        border-radius: var(--radius-round);
        text-decoration: none;
        font-weight: var(--font-weight-6);
        font-size: var(--font-size-3);
        transition: transform var(--animation-fade-in);
        box-shadow: var(--shadow-3);
    }

    .cta-button:hover {
        transform: translateY(var(--size-1));
        box-shadow: var(--shadow-4);
    }

    /* Services Section */
    .services {
        padding: var(--size-6) 0;
    }

    .services h2 {
        text-align: center;
        margin-bottom: var(--size-6);
    }

    .services-grid {
        --grid-auto-fit-min-column-size: 280px;
        gap: var(--size-4);
        margin-bottom: var(--size-6);
    }

    .service-card {
        padding: var(--size-5);
        border-radius: var(--radius-3);
        box-shadow: var(--shadow-2);
        transition: transform var(--animation-fade-in);
        border: var(--border-size-1) solid var(--gray-3);
    }

    .service-card:hover {
        transform: translateY(calc(-1 * var(--size-1)));
        box-shadow: var(--shadow-4);
    }

    .service-card h3 {
        color: var(--clr-accent);
        margin-bottom: var(--size-2);
    }

    .service-card p {
        padding: 0;
        max-inline-size: none;
    }

    .tech-stack {
        text-align: center;
        margin-bottom: var(--size-6);
    }

    .tech-stack h3 {
        margin-bottom: var(--size-3);
    }

    .tech-badges {
        display: flex;
        flex-wrap: wrap;
        gap: var(--size-2);
        justify-content: center;
    }

    .tech-badge {
        background: var(--clr-accent);
        color: var(--clr-bg-1);
        padding: var(--size-1) var(--size-3);
        border-radius: var(--radius-round);
        font-size: var(--font-size-1);
        font-weight: var(--font-weight-5);
    }

    .approach {
        padding: var(--size-5);
        border-radius: var(--radius-3);
        box-shadow: var(--shadow-2);
        border: var(--border-size-1) solid var(--gray-3);
    }

    .approach h3 {
        margin-bottom: var(--size-2);
    }

    .approach p {
        padding: 0;
        max-inline-size: none;
    }

    /* Portfolio Section */
    .portfolio {
        padding: var(--size-6) 0;
    }

    .portfolio h2 {
        text-align: center;
        margin-bottom: var(--size-6);
    }

    .projects-grid {
        --grid-auto-fit-min-column-size: 350px;
        gap: var(--size-4);
    }

    .project-card {
        border-radius: var(--radius-3);
        box-shadow: var(--shadow-2);
        overflow: hidden;
        transition: transform var(--animation-fade-in);
        border: var(--border-size-1) solid var(--gray-3);
    }

    .project-card:hover {
        transform: translateY(calc(-1 * var(--size-1)));
        box-shadow: var(--shadow-4);
    }

    .project-image {
        height: var(--size-13);
        background: var(--gray-2);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .placeholder-image {
        color: var(--gray-6);
        font-style: italic;
    }

    .project-content {
        padding: var(--size-4);
    }

    .project-content h3 {
        margin-bottom: var(--size-2);
    }

    .project-content p {
        padding: 0;
        max-inline-size: none;
        margin-bottom: var(--size-2);
    }

    .project-tech {
        display: flex;
        flex-wrap: wrap;
        gap: var(--size-1);
        margin-bottom: var(--size-3);
    }

    .project-tech span {
        background: var(--gray-2);
        color: var(--gray-8);
        padding: var(--size-1) var(--size-2);
        border-radius: var(--radius-2);
        font-size: var(--font-size-0);
    }

    .project-links {
        display: flex;
        gap: var(--size-2);
        margin-bottom: var(--size-3);
    }

    .project-link {
        color: var(--clr-accent);
        text-decoration: none;
        font-weight: var(--font-weight-5);
        padding: var(--size-1) var(--size-2);
        border: var(--border-size-1) solid var(--clr-accent);
        border-radius: var(--radius-2);
        transition: all var(--animation-fade-in);
        font-size: var(--font-size-1);
    }

    .project-link:hover {
        background: var(--clr-accent);
        color: var(--clr-bg-1);
    }

    .project-impact {
        font-style: italic;
        color: var(--green-6);
        font-size: var(--font-size-1);
        margin-bottom: 0;
        padding: 0;
    }

    /* Skills Section */
    .skills {
        padding: var(--size-6) 0;
    }

    .skills h2 {
        text-align: center;
        margin-bottom: var(--size-6);
    }

    .skills-grid {
        --grid-auto-fit-min-column-size: 300px;
        gap: var(--size-4);
    }

    .skill-category {
        padding: var(--size-5);
        border-radius: var(--radius-3);
        box-shadow: var(--shadow-2);
        border: var(--border-size-1) solid var(--gray-3);
    }

    .skill-category h3 {
        color: var(--clr-accent);
        margin-bottom: var(--size-3);
    }

    .skill-category li {
        padding: var(--size-1) 0;
        border-bottom: var(--border-size-1) solid var(--gray-3);
        color: var(--clr-fg-2);
    }

    .skill-category li:last-child {
        border-bottom: none;
    }

    /* Testimonials Section */
    .testimonials {
        padding: var(--size-6) 0;
    }

    .testimonials h2 {
        text-align: center;
        margin-bottom: var(--size-6);
    }

    .testimonials-grid {
        --grid-auto-fit-min-column-size: 300px;
        gap: var(--size-4);
    }

    .testimonial {
        margin: 0;
    }

    .testimonial cite {
        color: var(--clr-accent);
        font-weight: var(--font-weight-6);
        font-style: normal;
        display: block;
        margin-top: var(--size-2);
    }

    /* Availability Section */
    .availability {
        padding: var(--size-6) 0;
    }

    .availability h2 {
        text-align: center;
        margin-bottom: var(--size-6);
    }

    .availability-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--size-6);
        max-width: var(--size-content-2);
        margin: 0 auto;
    }

    .availability-info h3,
    .contact-info h3 {
        color: var(--clr-accent);
        margin-bottom: var(--size-2);
    }

    .availability-info p,
    .contact-info p {
        padding: 0;
        max-inline-size: none;
    }

    .status {
        display: flex;
        align-items: center;
        gap: var(--size-1);
        font-weight: var(--font-weight-6);
        margin-bottom: var(--size-4);
    }

    .status-indicator {
        width: var(--size-2);
        height: var(--size-2);
        border-radius: var(--radius-round);
    }

    .status-indicator.available {
        background: var(--green-6);
    }

    .availability-info li {
        padding: var(--size-1) 0;
        color: var(--clr-fg-2);
        position: relative;
        padding-left: var(--size-4);
    }

    .availability-info li::before {
        content: "✓";
        position: absolute;
        left: 0;
        color: var(--green-6);
        font-weight: var(--font-weight-7);
    }

    .contact-methods {
        gap: var(--size-2);
    }

    .contact-method {
        display: flex;
        align-items: center;
        gap: var(--size-3);
        padding: var(--size-3);
        border-radius: var(--radius-2);
        text-decoration: none;
        color: var(--clr-fg-1);
        transition: transform var(--animation-fade-in);
        box-shadow: var(--shadow-2);
        border: var(--border-size-1) solid var(--gray-3);
    }

    .contact-method:hover {
        transform: translateY(calc(-1 * var(--size-1)));
        box-shadow: var(--shadow-3);
    }

    .contact-method span {
        font-size: var(--font-size-4);
    }

    .contact-method div {
        display: flex;
        flex-direction: column;
    }

    .contact-method strong {
        color: var(--clr-accent);
        margin-bottom: var(--size-1);
    }

    .contact-method div span {
        font-size: var(--font-size-1);
        color: var(--clr-fg-2);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .hero-content {
            grid-template-columns: 1fr;
            gap: var(--size-4);
            text-align: center;
        }

        .hero-text {
            text-align: center;
        }

        .hero h1 {
            font-size: var(--font-size-7);
        }

        .hero-subtitle {
            font-size: var(--font-size-3);
        }

        .headshot-placeholder {
            width: var(--size-13);
            height: var(--size-13);
        }


        .availability-content {
            grid-template-columns: 1fr;
            gap: var(--size-4);
        }

        .services-grid,
        .projects-grid,
        .skills-grid,
        .testimonials-grid {
            --grid-auto-fit-min-column-size: 100%;
        }
    }
</style>