---
import Layout from '../layouts/Layout.astro';
import FractalWeb from '../components/FractalWeb';
const title = "Finn's Big Web";
---

<Layout>
	<div class="container">
		<h1>{title}</h1>
		<p>Explore my fractal web - zoom in to become disappointed.</p>
		<p>It will get better. You shut your eye-holes!</p>

		<div class="web-container">
			<FractalWeb client:load />
		</div>
	</div>
</Layout>

<style>
	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 1rem;
		text-align: center;
	}

	h1 {
		font-size: 3rem;
		margin-bottom: 0.5rem;
	}

	.web-container {
		display: flex;
		justify-content: center;
		width: 100%;
		height: 80vh;
		margin: 1rem 0;
	}
</style>