---
import Layout from '../layouts/Layout.astro';
import React from "react";

export const title = "Projects";

// Define projects data
const projects = [
  {
    title: "Shipping Container Project",
    description: "A 3D visualization of my shipping container build project. This interactive model shows the design and layout of a custom shipping container conversion.",
    image: "/images/shipping-container-image.png",
    link: "/projects/shipping-container"
  },
  {
    title: "Garden Renovation",
    description: "A complete redesign of an urban garden space, focusing on sustainable practices and native plant species. This project transformed a barren backyard into a thriving ecosystem.",
    image: "/images/rosebud.jpeg",
    link: "#"
  },
  {
    title: "Home Automation System",
    description: "A custom-built home automation system using open-source technologies. This project integrates lighting, climate control, and security into a single, user-friendly interface.",
    image: "/images/curtains-background.jpeg",
    link: "#"
  }
];
---
<style>
  #projects-listing {
    margin-inline: 2.5rem;
    position: relative;
  }

  .thread-container {
    position: relative;
    z-index: -1;
  }

  .background-thread {
    position: relative;
    left: 50%;
    top: -137px;
    height: 400px;
    width: 16px;
    transform: translateX(-50%);
    z-index: -1;

    /* Create a container for the rope strands */
    display: flex;
    flex-direction: column;
    overflow: visible;
  }

  /* Create the rope strands using pseudo-elements */
  .background-thread::before,
  .background-thread::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8px;
    background-color: #d2b48c;

    /* Twisted strand texture */
    background-image:
        repeating-linear-gradient(
            45deg,
            transparent,
            transparent 4px,
            rgba(0,0,0,0.1) 4px,
            rgba(0,0,0,0.1) 8px
        );

    /* Create wavy path for each strand */
    animation: ropeWave 12s infinite cubic-bezier(0.445, 0.05, 0.55, 0.95);
    transform-origin: top center;
  }

  .background-thread::before {
    left: -2px;
    animation-delay: 0s;
  }

  .background-thread::after {
    right: -2px;
    animation-delay: 4s;
  }


  @keyframes ropeWave {
    0% {
      transform: translateX(0) translateY(0) rotate(0deg);
    }
    10% {
      transform: translateX(2.5px) translateY(5px) rotate(1deg);
    }
    20% {
      transform: translateX(5px) translateY(10px) rotate(2deg);
    }
    30% {
      transform: translateX(2.5px) translateY(15px) rotate(1deg);
    }
    40% {
      transform: translateX(-2.5px) translateY(20px) rotate(-1deg);
    }
    50% {
      transform: translateX(-5px) translateY(15px) rotate(-2deg);
    }
    60% {
      transform: translateX(-4px) translateY(10px) rotate(-1.5deg);
    }
    70% {
      transform: translateX(-2.5px) translateY(5px) rotate(-1deg);
    }
    80% {
      transform: translateX(0px) translateY(10px) rotate(0deg);
    }
    90% {
      transform: translateX(1.5px) translateY(5px) rotate(0.5deg);
    }
    100% {
      transform: translateX(0) translateY(0) rotate(0deg);
    }
  }

  /* Add knots at project connections */
  .thread-knot {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translateX(-50%) translateY(-50%);
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: #b89b76;
    box-shadow:
        inset 0 0 0 3px rgba(0,0,0,0.15),
        inset 0 0 0 6px rgba(255,255,255,0.1),
        0 0 10px rgba(0,0,0,0.1);
    z-index: -1;
  }


  .project-container {
    display: flex;
    flex-direction: row;
    margin: 6rem 0;
    gap: 2rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .project-container.reverse {
    flex-direction: row-reverse;
  }

  .project-image {
    flex: 1.25;
    position: relative;
    z-index: 2;
  }

  .project-content {
    flex: 1;
    position: relative;
    z-index: 2;
  }

  .project-image img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    object-fit: cover;
  }

  .project-title {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .project-description {
    margin-bottom: 1rem;
  }

  .project-link {
    display: inline-block;
    padding: 0.5rem 1rem;
    background-color: var(--clr-accent);
    color: white;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
  }

  /* Mobile responsive design */
  @media (max-width: 768px) {
    .background-thread {
      top: 0px;
      height: 250px;
    }

    .project-container, .project-container.reverse {
      flex-direction: column;
    }

    .project-image, .project-content {
      flex: 1 1 100%;
    }
  }
</style>

<Layout>
  <div class="container">
    <h1>{title}</h1>
  </div>
  <p>Here are some of my projects.</p>
  <div id="projects-listing">
    {projects.map((project, index) => (
      <>
        {index > 0 && (
          <div class="thread-container" style="height: 120px;">
            <div class="background-thread">
              <div class="thread-knot"></div>
            </div>
          </div>
        )}
        <div class={`project-container ${index % 2 === 1 ? 'reverse' : ''}`}>
          <div class="project-image">
            <img src={project.image} alt={project.title} />
          </div>
          <div class="project-content">
            <h2 class="project-title">{project.title}</h2>
            <p class="project-description">{project.description}</p>
            <a href={project.link} class="project-link">View Project</a>
          </div>
        </div>
      </>
    ))}
  </div>

  <script>
    // JavaScript for any additional interactivity can be added here
  </script>
</Layout>
