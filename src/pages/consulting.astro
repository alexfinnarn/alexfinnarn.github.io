---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import FillIn from '../components/FillIn.astro';
import Draft from '../components/Draft.astro';
import SkillMenu from '../components/SkillMenu.astro';
import Callout from '../components/Callout.astro';
import Button from '../components/Button.astro';
import { shownSkills } from '../data/skills';
import { draft } from '../lib/draft';
---

<Base
  title="Consulting"
  description={draft('What Alex Finnarn can help with, from Drupal platforms and testing to AI-assisted workflows.')}
>
  <div class="container patch page">
    <PageHeader title="Consulting">
      <Draft what="Short intro to the Consulting page.">
        <p>I'm a generalist. Pick what you need from the menu below, and if your problem isn't on it, get in touch anyway.</p>
      </Draft>
    </PageHeader>
    <section class="section">
      {shownSkills.length > 0 ? (
        shownSkills.some((skill) => skill.draft) ? (
          <Draft what="Skills menu, in src/data/skills.ts.">
            <SkillMenu items={shownSkills} />
          </Draft>
        ) : (
          <SkillMenu items={shownSkills} />
        )
      ) : (
        <FillIn what="Skills menu, in src/data/skills.ts." />
      )}
    </section>
    <Callout label="Availability">
      <Draft what="One dated line on availability.">
        <p>October 2026: open to projects outside my day job.</p>
      </Draft>
    </Callout>
    <div class="actions">
      <Button href="/contact/">Contact</Button>
    </div>
  </div>
</Base>

<style>
  .actions {
    padding-block: var(--space-6) var(--space-section);
  }
</style>
