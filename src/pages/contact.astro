---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import FillIn from '../components/FillIn.astro';
import ContactList from '../components/ContactList.astro';
import { site } from '../site';
---

<Base title="Contact" description="How to get in touch with Alex Finnarn about a project.">
  <div class="container patch page">
    <PageHeader title="Contact">
      <p>Got a problem with a website, a Drupal platform or an AI workflow? Tell me about it, even if you're not sure it's a fit.</p>
    </PageHeader>
    <section class="section stack">
      <FillIn what="The gate and contact form (to build, once the gate is decided)." />
      <FillIn what="Booking link (Google Calendar appointment schedule)." />
      <ContactList
        items={[
          { label: 'LinkedIn', value: 'linkedin.com/in/alexfinnarn', href: site.linkedin },
          { label: 'Location', value: site.location },
        ]}
      />
    </section>
  </div>
</Base>

<style>
  .stack {
    display: grid;
    gap: var(--space-5);
  }
</style>
