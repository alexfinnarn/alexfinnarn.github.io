---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import FillIn from '../components/FillIn.astro';
import ContactList from '../components/ContactList.astro';
import { site } from '../site';
---

<Base title="Contact">
  <div class="container">
    <PageHeader title="Contact">
      <FillIn what="One sentence on what to get in touch about." />
    </PageHeader>
    <section class="section stack">
      <FillIn what="The gate and contact form (to build, once the gate is decided)." />
      <FillIn what="Booking link (Google Calendar appointment schedule)." />
      <ContactList
        items={[
          { label: 'LinkedIn', value: 'linkedin.com/in/alexfinnarn', href: site.linkedin },
          { label: 'Location', value: site.location },
        ]}
      />
    </section>
  </div>
</Base>

<style>
  .stack {
    display: grid;
    gap: var(--space-5);
  }
</style>
