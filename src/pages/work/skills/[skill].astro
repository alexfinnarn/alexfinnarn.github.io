---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import TopicList from '../../../components/TopicList.astro';
import ArticleListItem from '../../../components/ArticleListItem.astro';
import Button from '../../../components/Button.astro';
import { getWorkExamples, getSkillsWithWork, type WorkExample } from '../../../lib/content';

export async function getStaticPaths() {
  const examples = await getWorkExamples();
  const skills = getSkillsWithWork(examples);
  return skills.map((skill) => ({
    params: { skill: skill.slug },
    props: { skill, skills, examples: examples.filter((e) => e.skills.includes(skill.title)) },
  }));
}

interface Props {
  skill: { name: string; slug: string; description: string };
  skills: { name: string; slug: string }[];
  examples: WorkExample[];
}

const { skill, skills, examples } = Astro.props;
---

<Base title={`${skill.name} · Work`} description={skill.description}>
  <div class="container patch page">
    <PageHeader label="Work" title={skill.name}>
      <p>{skill.description}</p>
    </PageHeader>
    <TopicList topics={skills} current={skill.slug} label="Skills" base="/work/skills/" />
    <ul class="list">
      {examples.map((example) => (
        <ArticleListItem
          title={example.title}
          href={example.href}
          label={example.kind}
          description={example.summary}
          image={example.image}
          imageAlt={example.imageAlt}
        />
      ))}
    </ul>
    <p class="back"><a href="/work/">All work</a></p>
    <div class="actions">
      <Button href="/contact/">Contact</Button>
    </div>
  </div>
</Base>

<style>
  .list {
    margin: 0;
    padding: 0;
  }

  .back {
    margin-block: var(--space-6) 0;
    font-weight: 600;
  }

  .actions {
    padding-block: var(--space-6) var(--space-section);
  }
</style>
