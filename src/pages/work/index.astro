---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import FillIn from '../../components/FillIn.astro';
import ArticleListItem from '../../components/ArticleListItem.astro';
import Button from '../../components/Button.astro';
import { getCaseStudies } from '../../lib/content';

const caseStudies = await getCaseStudies();
---

<Base title="Work">
  <div class="container">
    <PageHeader title="Work">
      <FillIn what="One- or two-sentence intro to the Work page." />
    </PageHeader>
    {caseStudies.length > 0 ? (
      <ul class="list">
        {caseStudies.map((study) => (
          <ArticleListItem title={study.data.title} href={`/work/${study.id}/`} description={study.data.problem} />
        ))}
      </ul>
    ) : (
      <div class="empty"><FillIn what="Case studies (src/content/work/)." /></div>
    )}
    <div class="actions">
      <Button href="/consulting/">Consulting</Button>
      <Button href="/contact/" variant="secondary">Contact</Button>
    </div>
  </div>
</Base>

<style>
  .list {
    margin: 0;
    padding: 0;
  }

  .empty {
    padding-top: var(--space-block);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block: var(--space-6) var(--space-section);
  }
</style>
