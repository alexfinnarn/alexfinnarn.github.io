---
import Base from '../layouts/Base.astro';
import ForestScene from '../components/ForestScene.astro';
import ArticleListItem from '../components/ArticleListItem.astro';
import { getArticles, articleHref } from '../lib/content';
import { getForest } from '../lib/forest';
import { site } from '../site';
// "What I do" is hidden until there is more work to show (2026-11-14). To bring it back,
// uncomment these lines and the section further down.
// import SituationScraps from '../components/SituationScraps.astro';
// import { situations } from '../data/situations';

const featured = (await getArticles()).slice(0, 3);
const forest = await getForest();
---

<Base
  description="Alex Finnarn is a software consultant in Troy, Ohio, with twelve years of building and running everything on the web and a growing interest in industrial automation."
>
  {/* The drawing is the first thing on the page, and the browser would otherwise find it late. */}
  <link slot="head" rel="preload" as="image" type="image/webp" href={forest.src} fetchpriority="high" />
  <ForestScene
    label={`${site.role} · ${site.location}`}
    title={site.name}
    alt={`Colored-pencil drawing of ${site.name} sitting on a rock in a pine forest`}
  />

  {/* "What I do": hidden for now (see the note at the top of this file).
  {situations.length > 0 && (
    <section class="container section scraps">
      <h2 class="patch tilt">What I do</h2>
      <SituationScraps items={situations} />
      <p class="more patch tilt"><a href="/work/">All work</a></p>
    </section>
  )}
  */}

  {featured.length > 0 && (
    <section class="container section patch tilt">
      <h2>Writing</h2>
      <ul class="list">
        {featured.map((article) => (
          <ArticleListItem
            title={article.data.title}
            href={articleHref(article)}
            date={article.data.publishedDate}
            description={article.data.description}
            external={article.data.externalUrl ? 'Medium' : undefined}
          />
        ))}
      </ul>
      <p class="more"><a href="/writing/">All writing</a></p>
    </section>
  )}
</Base>

<style>
  .section {
    max-width: calc(var(--container) + 6rem);
    padding-inline: clamp(var(--space-5), 8vw, var(--space-9));
    /* Neighbouring patches overlap a little. */
    margin-block: calc(-1 * var(--space-5));
  }

  /* "What I do" has no big patch: the scraps sit on the hatching, and the heading and the
     link get small scraps of their own. */
  .scraps {
    margin-block: var(--space-8);
  }

  /* Like neighbouring patches, no rule across the hatching. */
  .scraps + .section {
    border-top: 0;
  }

  .scraps h2,
  .scraps .more {
    --patch-reach-block: var(--space-4);
    --patch-reach-inline: var(--space-5);
    --patch-mask: var(--scrap-mask);
    width: fit-content;
  }

  .scraps .more {
    margin-inline: auto;
  }

  .list {
    margin: 0;
    padding: 0;
  }

  .more {
    margin: var(--space-5) 0 0;
    font-weight: 600;
  }
</style>
