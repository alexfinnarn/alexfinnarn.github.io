---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Button from '../components/Button.astro';
import SkillAccordion from '../components/SkillAccordion.astro';
import ArticleListItem from '../components/ArticleListItem.astro';
import { Image } from 'astro:assets';
import forestImage from '../assets/me-on-rock-and-forest.png';
import { getArticles, articleHref, getWorkExamples, getSkillSlides } from '../lib/content';
import { site } from '../site';

const featured = (await getArticles()).slice(0, 3);
const slides = getSkillSlides(await getWorkExamples());
---

<Base
  description="Alex Finnarn is a software consultant in Troy, Ohio, with twelve years of building and running everything on the web and a growing interest in industrial automation."
>
  <Hero label={`${site.role} · ${site.location}`} title={site.name}>
    <p>
        After 12 years of working on the web, I am back to exploring the wilderness of opportunity and innovation within the intersction of software development and local manufacturing.
    </p>
    <Fragment slot="actions">
      <Button href="/work/">Work</Button>
      <Button href="/contact/" variant="secondary">Contact</Button>
    </Fragment>
    <Image
      slot="art"
      src={forestImage}
      alt={`Colored-pencil drawing of ${site.name} sitting on a rock in a pine forest`}
      widths={[800, 1280, forestImage.width]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </Hero>

  {slides.length > 0 && (
    <section class="container section patch">
      <h2>What I do</h2>
      <SkillAccordion slides={slides} />
      <p class="more"><a href="/work/">All work</a></p>
    </section>
  )}

  {featured.length > 0 && (
    <section class="container section patch tilt">
      <h2>Writing</h2>
      <ul class="list">
        {featured.map((article) => (
          <ArticleListItem
            title={article.data.title}
            href={articleHref(article)}
            date={article.data.publishedDate}
            description={article.data.description}
            external={article.data.externalUrl ? 'Medium' : undefined}
          />
        ))}
      </ul>
      <p class="more"><a href="/writing/">All writing</a></p>
    </section>
  )}
</Base>

<style>
  .section {
    max-width: calc(var(--container) + 6rem);
    padding-inline: clamp(var(--space-5), 8vw, var(--space-9));
    /* Neighbouring patches overlap a little. */
    margin-block: calc(-1 * var(--space-5));
  }

  .list {
    margin: 0;
    padding: 0;
  }

  .more {
    margin: var(--space-5) 0 0;
    font-weight: 600;
  }
</style>
