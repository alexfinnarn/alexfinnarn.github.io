---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import TopicList from '../../../components/TopicList.astro';
import ArticleList from '../../../components/ArticleList.astro';
import ArticleListItem from '../../../components/ArticleListItem.astro';
import { getArticles, getTopics, articleHref, type Article } from '../../../lib/content';

export async function getStaticPaths() {
  const articles = await getArticles();
  const topics = getTopics(articles);
  return topics.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic, topics, articles: articles.filter((a) => a.data.topics.includes(topic.name)) },
  }));
}

interface Props {
  topic: { name: string; slug: string };
  topics: { name: string; slug: string }[];
  articles: Article[];
}

const { topic, topics, articles } = Astro.props;
---

<Base title={`${topic.name} · Writing`}>
  <div class="container">
    <div class="patch head">
      <PageHeader label="Writing" title={topic.name} />
      <TopicList topics={topics} current={topic.slug} />
    </div>
    <ArticleList>
      {articles.map((article) => (
        <ArticleListItem
          level={2}
          title={article.data.title}
          href={articleHref(article)}
          date={article.data.publishedDate}
          description={article.data.description}
          image={article.data.image}
          imageAlt={article.data.imageAlt}
          external={article.data.externalUrl ? 'Medium' : undefined}
        />
      ))}
    </ArticleList>
    <p class="back patch tilt"><a href="/writing/">All writing</a></p>
  </div>
</Base>

<style>
  /* The heading and topics share a patch; each post below has its own. */
  .head {
    margin-bottom: var(--space-9);
  }

  .head :global(.page-header) {
    border-bottom: 0;
  }

  /* The link back gets a small scrap of paper of its own. */
  .back {
    --patch-reach-block: var(--space-4);
    --patch-reach-inline: var(--space-5);
    --patch-mask: var(--scrap-mask);
    width: fit-content;
    margin-block: var(--space-9) var(--space-section);
    font-weight: 600;
  }
</style>
