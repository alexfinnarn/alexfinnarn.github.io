---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import Button from '../../components/Button.astro';
import TopicList from '../../components/TopicList.astro';
import { getCaseStudies, topicSlug, type CaseStudyEntry } from '../../lib/content';

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();
  return caseStudies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

interface Props {
  study: CaseStudyEntry;
}

const { study } = Astro.props;
const { project, skills } = study.data;
// Case studies always have these; the schema leaves them optional for the other kinds.
const title = study.data.title ?? study.id;
const problem = study.data.problem ?? '';
const solution = study.data.solution ?? '';
const result = study.data.result ?? '';
const { Content } = await render(study);
---

<Base title={title} description={problem}>
  <article class="container patch page">
    <p class="crumb label"><a href="/work/">Work</a></p>
    <CaseStudy title={title} project={project} problem={problem} solution={solution} result={result} />
    {study.body?.trim() && (
      <div class="prose measure">
        <Content />
      </div>
    )}
    <TopicList topics={skills.map((name) => ({ name, slug: topicSlug(name) }))} label="Skills" base="/work/skills/" />
    <div class="actions">
      <Button href="/contact/">Contact</Button>
      <Button href="/work/" variant="secondary">All work</Button>
    </div>
  </article>
</Base>

<style>
  .crumb {
    padding-top: var(--space-section);
    margin-bottom: var(--space-4);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-block: var(--space-6) var(--space-section);
  }
</style>
