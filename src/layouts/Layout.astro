---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import StickySettings from "../components/StickySettings.astro";
export interface Props {
	title?: string;
}

const siteName = "Finn's Big Web";
const pageTitle = `${siteName} | ${Astro.props.title || "Default Page Title"}`;
---

<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width" />
	<link rel="icon" type="image/x-icon" href="/finn.ico" />
	<meta name="generator" content={Astro.generator} />
	<title>{pageTitle}</title>

	<link rel="stylesheet" href="/css/styles.css" />
</head>
<body>
  <a href="#main" class="visually-hidden">Skip to main content</a>
  <Header />
  <main id="main" tabindex="-1">
	  <slot />
  </main>
  <Footer />
  <StickySettings />
</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
