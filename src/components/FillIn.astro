---
// A visible gap for Alex to fill: text he hasn't written yet, or a piece not built yet.
// `grep -rn FillIn src/pages` lists every one.
interface Props {
  /** What goes here, e.g. "positioning line". */
  what: string;
}

const { what } = Astro.props;
---

<p class="fill-in"><strong>Fill in:</strong> {what}</p>

<style>
  .fill-in {
    max-width: var(--measure);
    padding: var(--space-3) var(--space-4);
    border: var(--line-2) dashed var(--color-rule);
    border-radius: var(--radius);
    font-family: var(--font-label);
    font-size: var(--size-sm);
    color: var(--color-text-muted);
  }
</style>
