---
// Home page opening: label, headline, lede and actions on a tilted paper patch, with a
// drawing beside it. Slots: default (lede text), "actions" (Buttons), "art" (an image; it
// fades into the page at ragged edges). On phones the drawing sits above the text.
interface Props {
  label?: string;
  title: string;
}

const { label, title } = Astro.props;
const hasArt = Astro.slots.has('art');
---

<section class:list={['hero', 'container', { 'has-art': hasArt }]}>
  <div class="text patch tilt">
    {label && <span class="label">{label}</span>}
    <h1>{title}</h1>
    <div class="lede measure"><slot /></div>
    <div class="actions"><slot name="actions" /></div>
  </div>
  {hasArt && <div class="art"><slot name="art" /></div>}
</section>

<style>
  .hero {
    max-width: 76rem;
    padding-block: var(--space-7);
    background: var(--hero-bg);
    color: var(--hero-text);
  }

  .has-art {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: var(--space-4);
  }

  .text {
    padding: var(--space-8) clamp(var(--space-5), 5vw, var(--space-8));
  }

  .label {
    color: var(--hero-muted);
  }

  .lede {
    margin-bottom: var(--space-5);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .art :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 48rem) {
    .has-art {
      grid-template-columns: 1fr;
    }

    .art {
      order: -1;
      width: min(100%, 24rem);
      margin-inline: auto;
    }
  }
</style>
