  }

  /* The pointer is the pencil being drawn with, over the whole drawing. */
  .scene[data-tool='1'] svg {
    cursor: var(--cursor-paint-1);
  }

  .scene[data-tool='2'] svg {
    cursor: var(--cursor-paint-2);
