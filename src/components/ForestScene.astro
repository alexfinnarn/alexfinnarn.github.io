  }

  /* ---- Motion: only for visitors who haven't asked for less of it ---- */

  .needles {
    pointer-events: none;
  }

  .needle {
    display: none;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    .needle {
      display: inline;
      animation: fall linear infinite;
    }

    /* One timeline, 5s long, starting 0.8s after the drawing loads:
       0-40%   the bird flies in from the left and lands on the first label
       40-62%  it rests there
       62-100% it hops up onto the backpack, where the second label appears */
    .fly {
      animation: fly 5s 0.8s backwards;
    }

    .wing-flap {
      animation:
        flap 0.2s ease-in-out 26 alternate,
        flapping 5s 0.8s step-end backwards;
    }

    .wing-fold {
      animation: folded 5s 0.8s step-end backwards;
    }

    .tag-first {
      animation: appear 0.5s 2.6s ease-out backwards;
    }

    .tag-second {
      animation: appear 0.5s 5.6s ease-out backwards;
    }

    /* Perched, it glances around every few seconds. */
    .bird {
      animation: look 7s 7s ease-in-out infinite;
    }

    .paused :is(.needle, .fly, .wing-flap, .wing-fold, .tag, .bird),
    .waiting :is(.needle, .fly, .wing-flap, .wing-fold, .tag, .bird) {
      animation-play-state: paused;
    }

    /* Needles frozen in mid-air would look wrong. */
    .waiting .needles {
      visibility: hidden;
    }

    .labels-now .tag {
      animation: none;
    }
  }

  /* Nothing moves, so there is nothing to pause. */
  @media (prefers-reduced-motion: reduce) {
