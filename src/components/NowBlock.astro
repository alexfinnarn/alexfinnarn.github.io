---
// Dated "what I'm doing now" panel: 3–5 short lines.
interface Props {
  asOf: string;
  items: string[];
  title?: string;
}

const { asOf, items, title = 'Now' } = Astro.props;
---

<aside class="now" aria-labelledby="now-heading">
  <div class="head">
    <h2 id="now-heading">{title}</h2>
    <span class="as-of">As of {asOf}</span>
  </div>
  <ul>
    {items.map((item) => <li>{item}</li>)}
  </ul>
</aside>

<style>
  .now {
    max-width: calc(var(--measure) + 4rem);
    padding: var(--space-5) var(--space-6);
    background: var(--panel-bg);
    border-top: var(--rule-strong);
    border-radius: var(--radius);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
    margin-bottom: var(--space-3);
  }

  h2 {
    font-size: var(--size-xl);
    margin: 0;
  }

  .as-of {
    font-family: var(--font-label);
    font-size: var(--size-sm);
    color: var(--color-text-muted);
  }

  ul {
    margin: 0;
    padding-left: 1.2em;
  }

  li + li {
    margin-top: var(--space-2);
  }
</style>
