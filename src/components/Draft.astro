---
// Copy Claude drafted that Alex hasn't approved yet (plans/active/copy-plan.md). Highlighted in
// dev. A production build shows the Fill in box instead, so nothing unapproved goes live.
// Alex removes the wrapper when a line is his. `grep -rn "<Draft" src` lists what's left.
import FillIn from './FillIn.astro';

interface Props {
  /** What goes here. Production shows it as the Fill in box. */
  what: string;
}

const { what } = Astro.props;
---

{import.meta.env.DEV ? (
  <div class="draft">
    <slot />
  </div>
) : (
  <FillIn what={what} />
)}

<style>
  .draft {
    position: relative;
    padding: var(--space-3) var(--space-4);
    border: var(--line-2) dashed var(--color-accent);
    border-radius: var(--radius);
    background: var(--color-accent-tint);
  }

  .draft::before {
    content: 'Draft';
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-label);
    font-size: var(--size-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .draft > :global(:first-child) {
    margin-top: 0;
  }

  .draft > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
