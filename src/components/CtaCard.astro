---
// Closing call to action on an article. Each article supplies its own (the `cta` field),
// so the heading, text, link and button label all come in as props or the default slot.
import Button from './Button.astro';

interface Props {
  heading: string;
  href: string;
  action: string;
}

const { heading, href, action } = Astro.props;
---

<aside class="cta" aria-label={heading}>
  <h2>{heading}</h2>
  <div class="body"><slot /></div>
  <Button href={href}>{action}</Button>
</aside>

<style>
  .cta {
    max-width: var(--measure);
    margin-top: var(--space-7);
    padding: var(--space-5) var(--space-6);
    background: var(--panel-bg);
    border-top: var(--rule-strong);
    border-radius: var(--radius);
  }

  h2 {
    font-size: var(--size-xl);
    margin-bottom: var(--space-2);
  }

  .body :global(p:last-child) {
    margin-bottom: var(--space-4);
  }
</style>
