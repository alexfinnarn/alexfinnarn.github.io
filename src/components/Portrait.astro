---
// Portrait for the About page. Without a src it renders an empty, labeled frame.
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
}

const { src, alt = '', caption } = Astro.props;
---

<figure class="portrait">
  {src ? (
    <img src={src} alt={alt} width="480" height="600" loading="lazy" />
  ) : (
    <div class="empty" role="img" aria-label="Portrait not yet chosen">Portrait</div>
  )}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .portrait {
    margin: 0;
    max-width: 18rem;
  }

  img,
  .empty {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .empty {
    display: grid;
    place-items: center;
    background: var(--color-bg-alt);
    border: var(--line-1) dashed var(--color-rule);
    color: var(--color-text-muted);
    font-family: var(--font-label);
    font-size: var(--size-sm);
  }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--size-sm);
    color: var(--color-text-muted);
  }
</style>
