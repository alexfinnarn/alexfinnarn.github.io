---
// Topic links, used on the Writing index and below each article.
interface Props {
  topics: { name: string; slug: string }[];
  /** Slug of the topic being viewed, marked as current. */
  current?: string;
  label?: string;
}

const { topics, current, label = 'Topics' } = Astro.props;
---

{topics.length > 0 && (
  <nav class="topics" aria-label={label}>
    <span class="label">{label}</span>
    <ul>
      {topics.map(({ name, slug }) => (
        <li>
          <a href={`/writing/topics/${slug}/`} aria-current={slug === current ? 'page' : undefined}>{name}</a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .topics {
    margin-block: var(--space-5);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border: var(--line-1) solid var(--color-rule);
    border-radius: var(--radius);
    font-family: var(--font-label);
    font-size: var(--size-sm);
    text-decoration: none;
  }

  a[aria-current='page'] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }
</style>
