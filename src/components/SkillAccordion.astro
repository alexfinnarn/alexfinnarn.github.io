---
// Home's "What I do": one row per skill, across the full content width. The open row shows a
// work example tagged with that skill: image, kind, title, summary, and links to it and to the
// skill's page on Work. The first row starts open; opening another closes it (`<details name>`),
// so it needs no script. Chosen in eye-test round 7 (docs/design/decisions.md).
// Each row has a pencil color (rounds 8 and 9): scribbled under its title when closed; when
// open, the title gets a drawn underline in that color and the row is colored in with it.
// The color also drifts in over the paper's edges from the hatching, in soft puffs, strongest
// for the open row, so the patch blends into the page (round 10).
import { Image } from 'astro:assets';
import { placeholderImage, workLinkText, type WorkExample } from '../lib/content';
import { pencilLine } from '../lib/pencil';

interface Props {
  slides: { skill: string; href: string; example: WorkExample }[];
  /** Groups the rows so only one is open. Unique per page. */
  name?: string;
}

const { slides, name = 'what-i-do' } = Astro.props;
---

<div class="accordion">
  {slides.map(({ skill, href, example }, i) => (
    <details name={name} open={i === 0} style={`--underline: ${pencilLine(i * 17 + 2, 4)}`}>
      <summary>
        {/* In the summary, since the rest of a closed row is hidden. */}
        <span class="puff" aria-hidden="true" />
        <span class="title">{skill}</span>
      </summary>
      <div class="body">
        <div class="thumb art">
          {example.image ? (
            <Image src={example.image} alt={example.imageAlt ?? ''} widths={[480, 800]} sizes="(max-width: 40rem) 100vw, 24rem" />
          ) : (
            <img src={placeholderImage(800, 500)} alt="" width="800" height="500" loading="lazy" />
          )}
        </div>
        <div class="text">
          <span class="label">{example.kind}</span>
          <h3><a href={example.href}>{example.title}</a></h3>
          <p class="summary">{example.summary}</p>
          <p class="links">
            <a href={example.href}>{workLinkText[example.kind]}</a>
            <a href={href}>More {skill}</a>
          </p>
        </div>
      </div>
    </details>
  ))}
</div>

<style>
  .accordion {
    border-top: var(--rule-strong);
    /* From the text out to the far edge of the patch's paper. The padding matches Home's
       sections (.section in src/pages/index.astro). */
    --spill-reach: calc(clamp(var(--space-5), 8vw, var(--space-9)) + var(--patch-reach-inline));
  }

  details {
    position: relative;
    border-bottom: var(--rule);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-4);
    font-family: var(--font-heading);
    font-weight: var(--weight-heading);
    font-size: var(--size-2xl);
    letter-spacing: var(--tracking-heading);
    line-height: var(--leading-heading);
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '+';
    color: var(--color-text-muted);
  }

  details[open] summary::after {
    content: '−';
  }

  summary:hover {
    color: var(--color-accent);
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--space-6);
    align-items: center;
    padding-bottom: var(--space-6);
  }

  .thumb img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }

  h3 {
    margin-block: var(--space-1) var(--space-2);
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .summary {
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    font-weight: 600;
  }

  /* Each row's pencil color, in order, repeating after six. */
  details:nth-child(6n + 1) { --mark: var(--mark-1); }
  details:nth-child(6n + 2) { --mark: var(--mark-2); }
  details:nth-child(6n + 3) { --mark: var(--mark-3); }
  details:nth-child(6n + 4) { --mark: var(--mark-4); }
  details:nth-child(6n + 5) { --mark: var(--mark-5); }
  details:nth-child(6n + 6) { --mark: var(--mark-6); }

  /* Its own layer, so the marks sit over the paper patch and under the title. */
  .title {
    position: relative;
    z-index: 0;
  }

  /* Closed: a scribble under the title, in a fixed band under the last line so a title that
     wraps isn't half covered. It grows a little on hover. */
  .title::before {
    content: '';
    position: absolute;
    inset: auto -0.3em -0.12em;
    height: 0.63em;
    z-index: -1;
    background: var(--mark);
    mask: var(--mark-band) 0 0 / 100% 100% no-repeat;
    opacity: 0.7;
    transition: height 160ms ease-out, opacity 160ms ease-out;
  }

  summary:hover .title::before {
    height: 0.9em;
  }

  /* Open: a drawn pencil underline instead of the scribble. */
  .title::after {
    content: '';
    position: absolute;
    inset: auto -0.15em -0.3em;
    height: 0.4em;
    z-index: -1;
    background: var(--mark);
    mask: var(--underline) 0 0 / 100% 100% no-repeat;
    opacity: 0;
    transition: opacity 160ms ease-out;
  }

  details[open] .title::before {
    opacity: 0;
  }

  details[open] .title::after {
    opacity: 1;
  }

  /* Open: the row colored in with loose hatching in its color. It shares the page's layer
     with the patch's paper and comes after it, so it paints over the paper and under the text.
     Light enough that every text color stays over 4.5:1, even where a streak is solid on blue
     or violet. */
  details[open]::before {
    content: '';
    position: absolute;
    /* The texture leaves its outer tenth ragged, so reach past the row to cover the title. */
    inset: calc(-1 * var(--space-4)) calc(-1 * var(--space-5)) calc(-1 * var(--space-2));
    z-index: -1;
    background: var(--mark);
    mask: var(--mark-fill) 0 0 / 100% 100% no-repeat;
    opacity: 0.25;
  }

  /* The row's color drifting in over the paper's edges: one soft round puff of its hatching on
     each side, fading out before the text. */
  .puff {
    position: absolute;
    inset-block: calc(-1 * var(--space-6));
    inset-inline: calc(-1 * var(--spill-reach));
    z-index: -1;
    pointer-events: none;
    opacity: 0.45;
    transition: opacity 200ms ease-out;
  }

  .puff::before,
  .puff::after {
    content: '';
    position: absolute;
    inset-block: 0;
    width: calc(2 * var(--spill-reach));
    background: var(--mark);
    mask:
      var(--mark-fill) 0 0 / 100% 100% no-repeat,
      radial-gradient(closest-side, #000 45%, transparent) 0 0 / 100% 100% no-repeat;
    mask-composite: intersect;
  }

  .puff::before {
    left: calc(-1 * var(--spill-reach) + var(--space-3));
  }

  .puff::after {
    right: calc(-1 * var(--spill-reach) + var(--space-3));
    scale: 1 0.8;
  }

  details:nth-child(even) .puff::before {
    scale: 1 0.8;
  }

  details:nth-child(even) .puff::after {
    scale: 1 1;
  }

  details[open] .puff {
    inset-block: calc(-1 * var(--space-8));
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .puff,
    .title::before,
    .title::after {
      transition: none;
    }
  }

  @media (max-width: 40rem) {
    summary {
      font-size: var(--size-xl);
    }

    .body {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
