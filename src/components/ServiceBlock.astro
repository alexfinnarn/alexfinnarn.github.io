---
// One "what I do" or engagement-type block: heading plus a short paragraph (default slot).
// Place several inside a .service-grid wrapper.
interface Props {
  title: string;
  label?: string;
}

const { title, label } = Astro.props;
---

<article class="service">
  {label && <span class="label">{label}</span>}
  <h3>{title}</h3>
  <div class="body"><slot /></div>
</article>

<style>
  .service {
    padding-top: var(--space-4);
    border-top: var(--rule-strong);
  }

  h3 {
    margin-bottom: var(--space-2);
  }

  .body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
