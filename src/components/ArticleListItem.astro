---
// One entry in an article or case study list. Wrap several in a <ul>.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { formatDate } from '../lib/content';

interface Props {
  title: string;
  href: string;
  date?: Date;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Links off the site, e.g. to Medium. Shown as a small mark after the date. */
  external?: string;
}

const { title, href, date, description, image, imageAlt = '', external } = Astro.props;
---

<li class:list={['article', { 'has-image': image }]}>
  {image && <Image class="thumb" src={image} alt={imageAlt} width={240} />}
  <div>
    {(date || external) && (
      <p class="meta">
        {date && <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>}
        {external && <span>On {external}</span>}
      </p>
    )}
    <h3><a href={href}>{title}</a></h3>
    {description && <p class="description">{description}</p>}
  </div>
</li>

<style>
  .article {
    padding-block: var(--space-5);
    border-bottom: var(--rule);
    list-style: none;
  }

  .has-image {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .thumb {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .meta {
    display: flex;
    gap: var(--space-3);
    font-family: var(--font-label);
    font-size: var(--size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-1);
  }

  h3 {
    margin-bottom: var(--space-2);
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .description {
    max-width: var(--measure);
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 30rem) {
    .has-image {
      grid-template-columns: 1fr;
    }
  }
</style>
