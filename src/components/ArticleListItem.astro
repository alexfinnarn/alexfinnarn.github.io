---
// One entry in an article or work list. Wrap several in a <ul>.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { formatDate } from '../lib/content';

interface Props {
  title: string;
  href: string;
  date?: Date;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Links off the site, e.g. to Medium. Shown after the date. */
  external?: string;
  /** A short tag before the title, e.g. a work example's kind. */
  label?: string;
  /** Heading level of the title: 3 under a section's h2 (the default), 2 right under the page's h1. */
  level?: 2 | 3;
}

const { title, href, date, description, image, imageAlt = '', external, label, level = 3 } = Astro.props;
const Heading = `h${level}` as const;
---

<li class:list={['article', { 'has-image': image }]}>
  {image && <Image class="thumb" src={image} alt={imageAlt} width={240} />}
  <div>
    {label && <p class="kind">{label}</p>}
    <Heading class="title"><a class="title-link" href={href}>{title}</a></Heading>
    {description && <p class="description">{description}</p>}
    <div class="foot">
      {(date || external) && (
        <p class="meta">
          {date && <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>}
          {external && <span>On {external}</span>}
        </p>
      )}
      <a class="read-more" href={href}>Read more<span class="visually-hidden">: {title}</span> →</a>
    </div>
  </div>
</li>

<style>
  .article {
    padding-block: var(--space-5);
    border-bottom: var(--rule);
    list-style: none;
  }

  .has-image {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .thumb {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }

  .kind {
    font-family: var(--font-label);
    font-size: var(--size-sm);
    color: var(--color-text-muted);
    text-transform: capitalize;
    margin-bottom: var(--space-1);
  }

  /* Under the description: the date on the left, "Read more" on the right. */
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    max-width: var(--measure);
    margin-top: var(--space-4);
  }

  .meta {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    font-family: var(--font-label);
    font-size: var(--size-sm);
    color: var(--color-text-muted);
  }

  /* The post's pencil color (--post-mark, set by ArticleList) as a short dash before the
     date and as the underline of "Read more". Blue outside a list. */
  time {
    position: relative;
    padding-inline-start: 1.9em;
  }

  time::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.3em;
    width: 1.6em;
    height: 0.75em;
    background: var(--post-mark, var(--mark-5));
    mask: var(--link-underline) 0 0 / 100% 100% no-repeat;
  }

  .read-more {
    position: relative;
    margin-inline-start: auto;
    padding-bottom: var(--link-underline-gap);
    color: var(--color-text);
    font-family: var(--font-label);
    font-weight: 600;
    text-decoration: none;
  }

  .read-more::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: var(--link-underline-size);
    background: var(--post-mark, var(--mark-5));
    mask: var(--link-underline) 0 0 / 100% 100% no-repeat;
  }

  .read-more:hover {
    color: var(--color-accent);
  }

  .read-more:hover::after {
    height: var(--link-underline-hover-size);
  }

  /* Looks the same at either heading level. */
  .title {
    font-size: var(--size-xl);
    margin-bottom: var(--space-2);
  }

  .description {
    max-width: var(--measure);
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 30rem) {
    .has-image {
      grid-template-columns: 1fr;
    }
  }
</style>
